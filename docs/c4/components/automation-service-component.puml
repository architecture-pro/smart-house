@startuml

title Smart House Automation Service Component Diagram

top to bottom direction

!include ../c4-local/C4-Component.puml

Container( ApiGateway, "API Controller", "Go", "Принимает, проверяет и маршрутизирует запросы")

Container( TelemetryService, "Сервис Телеметрии", "NestJS", "Обработка данных телеметрии устройств")

Container( DeviceIntegrationService, "Сервис Интеграции Устройств", "Go", "Интеграция с устройствами по стандартным протоколам")

Container_Boundary(AutomationService, "Automation Service") {

    Component(AutomationController, "Контроллер автоматизации", "Обрабатывает запросы на управление сценариями и правилами автоматизации")

    Component(TelemetryController, "Контроллер телеметрии", "Обрабатывает входящие данные телеметрии для проверки правил и сценариев")

    Component(ServiceLayer, "Сервисный слой", "Бизнес-логика")

    Component(DataAccessLayer, "Слой доступа к данным", "Работа со сценариями и правилами автоматизации")
}

ContainerDb(AutomationDb, "БД Автоматизации", "PostgreSQL", "Хранение сценариев и правил автоматизации")

Rel(ApiGateway, AutomationController, "Вызывает API Сервиса Автоматизации", "JSON/HTTPs RestAPI")

Rel(AutomationController, ServiceLayer, "Вызывает бизнес-логику")

Rel(TelemetryService, TelemetryController, "Передает данные телеметрии для проверки правил и сценариев")

Rel(TelemetryController, ServiceLayer, "Вызывает бизнес-логику")

Rel(ServiceLayer, DataAccessLayer, "Читает и изменяет данные")

Rel(DataAccessLayer, AutomationDb, "Читает и сохраняет данные", "PostgreSQL")

Rel(ServiceLayer, DeviceIntegrationService, "Передает команды управления устройствами")

@enduml
