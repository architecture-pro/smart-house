@startuml

title Smart House User Service Component Diagram

top to bottom direction

!include ../c4-local/C4-Component.puml

Container_Boundary(UserService, "User Service") {

    Component(AuthController, "Контроллер аутентификации", "Обрабатывает запросы аутентификации пользователей")

    Component(UserController, "Контроллер пользователей", "Обрабатывает запросы управления пользователями")

    Component(HouseController, "Контроллер домов", "Обрабатывает запросы управления домами и доступом пользователей")

    Component(ServiceLayer, "Сервисный слой", "Бизнес-логика")

    Component(DataAccessLayer, "Слой доступа к данным", "Работа с данными пользователей и домов")
}

ContainerDb(UserDb, "БД Пользователей", "PostgreSQL", "Хранение и обработка данных пользователей")

Rel(AuthController, ServiceLayer, "Вызывает бизнес-логику")
Rel(UserController, ServiceLayer, "Вызывает бизнес-логику")
Rel(HouseController, ServiceLayer, "Вызывает бизнес-логику")

Rel(ServiceLayer, DataAccessLayer, "Читает и изменяет данные")

Rel(DataAccessLayer, UserDb, "Читает и сохраняет данные", "PostgreSQL")

@enduml