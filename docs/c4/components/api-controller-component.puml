@startuml

title Smart House API Controller Component Diagram

top to bottom direction

!include ../c4-local/C4-Component.puml

Container(WebApp, "Веб приложение", "Angular", "Пользовательский интерфейс")
Container_Boundary(ApiGateway, "API Controller" ) {
    Component(Router, "Маршрутизатор", "Маршрутизирует входящие запросы к нужным микросервисам")

    Component(AuthMiddleware, "Middleware авторизации", "Проверяет аутентификацию пользователя")

    Component(RequestValidator, "Валидатор запросов", "Проверяет корректность входящих запросов")

    Component(ServiceProxy, "Прокси сервисов", "Передает запросы соответствующим микросервисам")
}

Container(UserService, "Сервис Пользователей", "Go", "Аутентификация пользователей и управление доступом к домам")

Container(DeviceService, "Сервис Устройств", "Go", "Регистрация, подключение и управление устройствами")

Container(TelemetryService, "Сервис Телеметрии", "NestJS", "Обработка данных телеметрии устройств")

Container(AutomationService, "Сервис Автоматизации", "Go", "Управление сценариями автоматизации")

Rel(WebApp, Router, "Вызывает API", "JSON/HTTPs RestAPI")
Rel(Router, AuthMiddleware, "Обработка запроса")
Rel(AuthMiddleware, RequestValidator, "Обработка запроса")
Rel(RequestValidator, ServiceProxy, "Обработка запроса")

Rel(ServiceProxy, UserService, "Вызывает API", "JSON/HTTPs RestAPI")
Rel(ServiceProxy, DeviceService, "Вызывает API", "JSON/HTTPs RestAPI")
Rel(ServiceProxy, TelemetryService, "Вызывает API", "JSON/HTTPs RestAPI")
Rel(ServiceProxy, AutomationService, "Вызывает API", "JSON/HTTPs RestAPI")

@enduml